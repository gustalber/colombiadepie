{
  "name": "colombiadepie-backend",
  "version": "1.0.0",
  "description": "Backend for Colombia de Pie — shelter coordination and last-mile needs matching",
  "main": "bin/index.js",
  "scripts": {
    "start": "node bin/index.js",
    "dev": "node --watch bin/index.js",
    "sls:dev": "AWS_PROFILE=colombiadepie sls offline --stage dev",
    "sls:deploy:dev": "AWS_PROFILE=colombiadepie sls deploy --stage dev",
    "sls:deploy:staging": "AWS_PROFILE=colombiadepie sls deploy --stage staging",
    "sls:remove:staging": "AWS_PROFILE=colombiadepie sls remove --stage staging",
    "sls:deploy:prod": "AWS_PROFILE=colombiadepie sls deploy --stage prod",
    "domain:create:dev": "AWS_PROFILE=colombiadepie sls create_domain --stage dev",
    "domain:create:staging": "AWS_PROFILE=colombiadepie sls create_domain --stage staging",
    "domain:create:prod": "AWS_PROFILE=colombiadepie sls create_domain --stage prod",
    "logs:app:dev": "AWS_PROFILE=colombiadepie sls logs -f app --stage dev --tail",
    "sls:logs:staging": "AWS_PROFILE=colombiadepie sls logs -f app --stage staging --tail",
    "sls:logs:prod": "AWS_PROFILE=colombiadepie sls logs -f app --stage prod --tail",
    "migrate": "sequelize-cli db:migrate",
    "migrate:dev": "NODE_ENV=development sequelize-cli db:migrate",
    "migrate:staging": "NODE_ENV=staging sequelize-cli db:migrate",
    "migrate:prod": "NODE_ENV=production sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:staging": "NODE_ENV=staging sequelize-cli db:migrate:undo",
    "migrate:undo:prod": "NODE_ENV=production sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate:status:dev": "NODE_ENV=development sequelize-cli db:migrate:status",
    "migrate:status:staging": "NODE_ENV=staging sequelize-cli db:migrate:status",
    "migrate:status:prod": "NODE_ENV=production sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "bootstrap:admin": "node scripts/bootstrap-admin.js",
    "bootstrap:admin:dev": "NODE_ENV=development node scripts/bootstrap-admin.js",
    "bootstrap:admin:staging": "NODE_ENV=staging node scripts/bootstrap-admin.js",
    "bootstrap:admin:prod": "NODE_ENV=production node scripts/bootstrap-admin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "serverless-domain-manager": "^10.1.0",
    "serverless-offline": "^14.5.0"
  }
}
