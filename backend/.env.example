PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=12h

# --- PostgreSQL local (npm run dev) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=colombiadepie
DB_USER=postgres
DB_PASSWORD=postgres

# --- PostgreSQL Neon (deploy + migraciones por stage) ---
# Dashboard Neon → Connect → "Pooled connection" (-pooler-)
# Solo estas URLs van a Lambda; DB_* de arriba NO se suben.
DATABASE_URL_DEV=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_STAGING=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_PROD=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Serverless — profile AWS de la cuenta de Colombia de Pie
AWS_PROFILE=colombiadepie

# Custom domain
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:ACCOUNT:certificate/UUID
# DOMAIN_DEV=api-dev.colombiadepie.com
# DOMAIN_STAGING=api-staging.colombiadepie.com
# DOMAIN_PROD=api.colombiadepie.com

# --- Bootstrap primer coordinador (solo CLI, no sube a Lambda) ---
# BOOTSTRAP_ADMIN_EMAIL=coordinador@ejemplo.com
# BOOTSTRAP_ADMIN_PASSWORD=contraseña-segura-min-10-chars
# BOOTSTRAP_ADMIN_NOMBRE=Nombre Coordinador
# BOOTSTRAP_ADMIN_ROL=coordinador
# BOOTSTRAP_RESET_PASSWORD=true
